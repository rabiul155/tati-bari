# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, or local `npx prisma dev`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public base URL of the site, used for links and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Signs admin session cookies (at least 32 characters). Generate with:
#   openssl rand -base64 32
# Changing it signs the admin out.
SESSION_SECRET="replace-with-a-long-random-string"

# Product image storage (Cloudinary). When unset, images are saved to the
# local ./.uploads folder, which only works in development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Set to "true" to allow local-disk uploads with `next start` (local testing only).
ALLOW_LOCAL_UPLOADS=""
